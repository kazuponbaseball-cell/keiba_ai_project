    "recipe_id": {"const": "historical_ai_duplicate_gate_impact_v1"},
    "recipe_version": {"type": "integer", "const": 1},
    "gate_kind": {"const": "registered_nonpromotion_diagnostic_v1"},
    "tier": {"const": "B_REGISTERED_HISTORICAL_IMPACT"},
    "status": {"const": "REGISTERED_PENDING_LANE_CUTOVER_AND_CATALOG_RELEASE"},
    "source_authority_class": {"const": "B_LOCAL_HASHED"},
    "evidence_purpose_class": {"const": "DIAGNOSTIC_NONPROMOTION"},
    "source_design": {"$ref": "#/definitions/source_design"},
    "ordinary_strategy_score": {"$ref": "#/definitions/ordinary_strategy_score"},
    "question_family_source": {"$ref": "#/definitions/question_family_source"},
    "comparison": {"$ref": "#/definitions/comparison"},
    "recipe_contract": {"$ref": "#/definitions/recipe_contract"},
    "catalog_requirements": {"$ref": "#/definitions/catalog_requirements"},
    "source_inventory": {"$ref": "#/definitions/source_inventory"},
    "cohort": {"$ref": "#/definitions/cohort"},
    "metric": {"$ref": "#/definitions/metric"},
    "sensitivity": {"$ref": "#/definitions/sensitivity"},
    "bootstrap": {"$ref": "#/definitions/bootstrap"},
    "execution_contract": {"$ref": "#/definitions/execution_contract"},
    "phase_plan": {"$ref": "#/definitions/phase_plan"},
    "replica_topology": {"$ref": "#/definitions/replica_topology"},
    "output_contract": {"$ref": "#/definitions/output_contract"},
    "result_contract": {"$ref": "#/definitions/result_contract"},
    "safety": {"$ref": "#/definitions/safety"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pull_request",
        "merge_commit",
        "contract_map_path",
        "contract_map_git_blob_sha",
        "contract_map_git_blob_content_sha256",
        "formula_fingerprint_sha256",
        "authority"
      ],
      "properties": {
        "pull_request": {"type": "integer", "const": 40},
        "merge_commit": {"$ref": "#/definitions/git_sha"},
        "contract_map_path": {"const": "research/drafts/MODEL_INTEGRITY_DIAGNOSTIC_GATE_V1_CONTRACT_MAP.design.json"},
        "contract_map_git_blob_sha": {"$ref": "#/definitions/git_sha"},
        "contract_map_git_blob_content_sha256": {"$ref": "#/definitions/sha256"},
        "formula_fingerprint_sha256": {"const": "67b0d3e5b92166a10b3077bff03e107c9db071b310f60f43b8758ce316eda878"},
        "authority": {"const": false}
      }
    },
    "ordinary_strategy_score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_total",
        "threshold",
        "threshold_met",
        "status",
        "score_credit",
        "threshold_override_allowed"
      ],
      "properties": {
        "recorded_total": {"type": "integer", "const": 46},
        "threshold": {"type": "integer", "const": 75},
        "threshold_met": {"const": false},
        "status": {"const": "BLOCKED_SCORE"},
        "score_credit": {"type": "integer", "const": 0},
        "threshold_override_allowed": {"const": false}
      }
    },
    "question_family_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable_source_lineage_id",
        "reference_ast_node_id",
        "target_decision_registry_id",
        "population_registry_id",
        "metric_registry_id",
        "recipe_display_fields_affect_digest"
      ],
      "properties": {
        "immutable_source_lineage_id": {"const": "M1C_C0_OFFSET_WIDE_TOP1_ACTION_POLICY"},
        "reference_ast_node_id": {"const": "RAW_P_GATE_FAMILY"},
        "target_decision_registry_id": {"const": "POSTFREEZE_WIDE_VALUE_ELIGIBILITY"},
        "population_registry_id": {"const": "CITED_FOLDS_2_TO_4"},
        "metric_registry_id": {"const": "PAIRED_UNIT_NOTIONAL_PROFIT_PER_ENROLLED_RACE"},
        "recipe_display_fields_affect_digest": {"const": false}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_id",
        "arm_ids",
        "registered_transform_id",
        "counterfactual_eligibility_mask_change",
        "candidate_identity_change",
        "candidate_rank_or_tier_change",
        "live_policy_or_config_mutation",
        "threshold_search_count",
        "refit_count",
        "recalibration_count"
      ],
      "properties": {
        "comparison_id": {"const": "D1_REMOVE_RAW_GATES_MINUS_D0_REFERENCE"},
        "arm_ids": {"const": ["D0_REFERENCE", "D1_REMOVE_RAW_GATES"]},
        "registered_transform_id": {"const": "REMOVE_RAW_P_GATE_FAMILY"},
        "counterfactual_eligibility_mask_change": {"const": true},
        "candidate_identity_change": {"const": false},
        "candidate_rank_or_tier_change": {"const": false},
        "live_policy_or_config_mutation": {"const": false},
        "threshold_search_count": {"type": "integer", "const": 0},
        "refit_count": {"type": "integer", "const": 0},
        "recalibration_count": {"type": "integer", "const": 0}
      }
    },
    "boolean_clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "column", "value"],
      "properties": {
        "op": {"const": "boolean_eq"},
        "column": {"enum": ["eligible_race", "candidate_generated"]},
        "value": {"const": true}
      }
    },
    "p_clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "column", "value"],
      "properties": {
        "op": {"enum": ["ge", "lt"]},
        "column": {"const": "top1_wide_prob"},
        "value": {"enum": ["0.225", "0.325", "0.21275851149504352"]}
      }
    },
    "a_clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "column", "value"],
      "properties": {
        "op": {"enum": ["ge", "lt"]},
        "column": {"const": "p_action_C0_offset"},
        "value": {"enum": ["0.25", "0.4"]}
      }
    },
    "and_clause_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "clause_refs"],
      "properties": {
        "op": {"const": "and"},
        "clause_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "eligible_race_true",
              "candidate_generated_true",
              "p_ge_0_225",
              "p_lt_0_325",
              "p_ge_primary_0_21275851149504352",
              "a_ge_0_25",
              "a_lt_0_4"
            ]
          }
        }
      }
    },
    "and_arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "node_refs"],
      "properties": {
        "op": {"const": "and"},
        "node_refs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["ACTION_GATE", "DECISION_BASE", "RAW_P_GATE_FAMILY"]}
        }
      }
    },
    "recipe_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_id",
        "numeric_semantics",
        "numeric_parser_and_runtime_hash_required_in_run_scope",
        "threshold_literals_are_canonical_decimal_strings",
        "p_column",
        "a_column",
        "a_lineage_formula",
        "decision_uses_hash_bound_stored_a_bytes",
        "trusted_verifier_verifies_candidate_entry_provenance_attestation_for_p_action_cross_source_equality",
        "trusted_verifier_recomputes_a_decision_base_d0_and_d1_for_every_row",
        "runner_self_asserted_masks_are_authority",
        "shared_decision_base_vector_digest_required",
        "shared_decision_base_producer_schema_and_lineage_digest_required",
        "shared_candidate_key_p_a_calibrator_fit_data_label_bytes_required",
        "clause_registry",
        "typed_gate_nodes",
        "arm_asts",
        "allowed_ast_diff",
        "expected_relation",
        "allowed_disagreement",
        "expected_d1_only_raw_p_region",
        "expected_d1_only_a_region",
        "d0_true_d1_false_action",
        "formula_ast_digest_required",
        "calibrator_refit_allowed",
        "threshold_override_allowed"
      ],
      "properties": {
        "comparison_id": {"const": "D1_REMOVE_RAW_GATES_MINUS_D0_REFERENCE"},
        "numeric_semantics": {"const": "IEEE754_BINARY64_FROM_UTF8_DECIMAL"},
        "numeric_parser_and_runtime_hash_required_in_run_scope": {"const": true},
        "threshold_literals_are_canonical_decimal_strings": {"const": true},
        "p_column": {"const": "top1_wide_prob"},
        "a_column": {"const": "p_action_C0_offset"},
        "a_lineage_formula": {"const": "sigmoid(logit(p)+0.130654047367905)"},
        "decision_uses_hash_bound_stored_a_bytes": {"const": true},
        "trusted_verifier_verifies_candidate_entry_provenance_attestation_for_p_action_cross_source_equality": {"const": true},
        "trusted_verifier_recomputes_a_decision_base_d0_and_d1_for_every_row": {"const": true},
        "runner_self_asserted_masks_are_authority": {"const": false},
        "shared_decision_base_vector_digest_required": {"const": true},
        "shared_decision_base_producer_schema_and_lineage_digest_required": {"const": true},
        "shared_candidate_key_p_a_calibrator_fit_data_label_bytes_required": {"const": true},
        "clause_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eligible_race_true",
            "candidate_generated_true",
            "p_ge_0_225",
            "p_lt_0_325",
            "p_ge_primary_0_21275851149504352",
            "a_ge_0_25",
            "a_lt_0_4"
          ],
          "properties": {
            "eligible_race_true": {
              "allOf": [
                {"$ref": "#/definitions/boolean_clause"},
                {"properties": {"column": {"const": "eligible_race"}}}
              ]
            },
            "candidate_generated_true": {
              "allOf": [
                {"$ref": "#/definitions/boolean_clause"},
                {"properties": {"column": {"const": "candidate_generated"}}}
              ]
            },
            "p_ge_0_225": {
              "allOf": [
                {"$ref": "#/definitions/p_clause"},
                {"properties": {"op": {"const": "ge"}, "value": {"const": "0.225"}}}
              ]
            },
            "p_lt_0_325": {
              "allOf": [
                {"$ref": "#/definitions/p_clause"},
                {"properties": {"op": {"const": "lt"}, "value": {"const": "0.325"}}}
              ]
            },
            "p_ge_primary_0_21275851149504352": {
              "allOf": [
                {"$ref": "#/definitions/p_clause"},
                {"properties": {"op": {"const": "ge"}, "value": {"const": "0.21275851149504352"}}}
              ]
            },
            "a_ge_0_25": {
              "allOf": [
                {"$ref": "#/definitions/a_clause"},
                {"properties": {"op": {"const": "ge"}, "value": {"const": "0.25"}}}
              ]
            },
            "a_lt_0_4": {
              "allOf": [
                {"$ref": "#/definitions/a_clause"},
                {"properties": {"op": {"const": "lt"}, "value": {"const": "0.4"}}}
              ]
            }
          }
        },
        "typed_gate_nodes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["DECISION_BASE", "RAW_P_GATE_FAMILY", "ACTION_GATE"],
          "properties": {
            "DECISION_BASE": {
              "allOf": [
                {"$ref": "#/definitions/and_clause_node"},
                {"properties": {"clause_refs": {"const": ["candidate_generated_true", "eligible_race_true"]}}}
              ]
            },
            "RAW_P_GATE_FAMILY": {
              "allOf": [
                {"$ref": "#/definitions/and_clause_node"},
                {"properties": {"clause_refs": {"const": ["p_ge_0_225", "p_ge_primary_0_21275851149504352", "p_lt_0_325"]}}}
              ]
            },
            "ACTION_GATE": {
              "allOf": [
                {"$ref": "#/definitions/and_clause_node"},
                {"properties": {"clause_refs": {"const": ["a_ge_0_25", "a_lt_0_4"]}}}
              ]
            }
          }
        },
        "arm_asts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["D0_REFERENCE", "D1_REMOVE_RAW_GATES"],
          "properties": {
            "D0_REFERENCE": {
              "allOf": [
                {"$ref": "#/definitions/and_arm"},
                {"properties": {"node_refs": {"const": ["ACTION_GATE", "DECISION_BASE", "RAW_P_GATE_FAMILY"]}}}
              ]
            },
            "D1_REMOVE_RAW_GATES": {
              "allOf": [
                {"$ref": "#/definitions/and_arm"},
                {"properties": {"node_refs": {"const": ["ACTION_GATE", "DECISION_BASE"]}}}
              ]
            }
          }
        },
        "allowed_ast_diff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "removed_node_refs",
            "added_node_refs",
            "changed_clause_ids",
            "changed_threshold_ids",
            "changed_non_ai_clause_ids"
          ],
          "properties": {
            "removed_node_refs": {"const": ["RAW_P_GATE_FAMILY"]},
            "added_node_refs": {"const": []},
            "changed_clause_ids": {"const": []},
            "changed_threshold_ids": {"const": []},
            "changed_non_ai_clause_ids": {"const": []}
          }
        },
        "expected_relation": {"const": "D0_SUBSET_OF_D1"},
        "allowed_disagreement": {"const": "D1_TRUE_D0_FALSE_ONLY"},
        "expected_d1_only_raw_p_region": {"const": "0.325<=p<0.36909082652451414"},
        "expected_d1_only_a_region": {"const": "0.35429028335310075<=a<0.4"},
        "d0_true_d1_false_action": {"const": "INVALID"},
        "formula_ast_digest_required": {"const": true},
        "calibrator_refit_allowed": {"const": false},
        "threshold_override_allowed": {"const": false}
      }
    },
    "candidate_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_columns", "forbidden_columns", "key"],
      "properties": {
        "required_columns": {
          "const": [
            "candidate_generated",
            "candidate_key",
            "eligible_race",
            "fold",
            "horse_a",
            "horse_b",
            "p_action_C0_offset",
            "race_date",
            "race_id",
            "top1_wide_prob",
            "venue_code"
          ]
        },
        "forbidden_columns": {
          "const": [
            "candidate_hit",
            "hit",
            "official_outcome_joined",
            "official_wide_pay",
            "return_yen",
            "roi",
            "wide_odds_high",
            "wide_odds_low",
            "wide_pay",
            "wide_popularity"
          ]
