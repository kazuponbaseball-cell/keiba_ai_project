    "settlement_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_columns", "key"],
      "properties": {
        "required_columns": {"const": ["race_id", "candidate_key", "candidate_hit", "official_outcome_completeness", "official_wide_pay"]},
        "key": {"const": ["race_id", "candidate_key"]}
      }
    },
    "catalog_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_active_release_count",
        "exact_entry_count",
        "allowed_roles",
        "candidate_role",
        "settlement_role",
        "candidate_and_settlement_must_be_distinct_content_objects"
      ],
      "properties": {
        "exact_active_release_count": {"type": "integer", "const": 1},
        "exact_entry_count": {"type": "integer", "const": 2},
        "allowed_roles": {"const": ["candidate_only_projection", "settlement_projection"]},
        "candidate_role": {"$ref": "#/definitions/candidate_role"},
        "settlement_role": {"$ref": "#/definitions/settlement_role"},
        "candidate_and_settlement_must_be_distinct_content_objects": {"const": true}
      }
    },
    "inventory_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "sha256"],
      "properties": {
        "role": {
          "enum": [
            "diagnostic_master",
            "p_action_artifact",
            "official_payoff_source",
            "r0_policy",
            "r0_reference_implementation",
            "r0_audit_config",
            "calibrator_fit_rows_with_labels",
            "calibrator_summary",
            "calibrator_producer"
          ]
        },
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_materialization_sources", "settlement_materialization_sources", "lineage_sources"],
      "properties": {
        "candidate_materialization_sources": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/inventory_item"},
          "allOf": [
            {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "diagnostic_master"}}}},
            {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "p_action_artifact"}}}}
          ]
        },
        "settlement_materialization_sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "allOf": [
              {"$ref": "#/definitions/inventory_item"},
              {"properties": {"role": {"const": "official_payoff_source"}}}
            ]
          }
        },
        "lineage_sources": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/inventory_item"},
          "allOf": [
            {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "r0_policy"}}}},
            {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "r0_reference_implementation"}}}},
            {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "r0_audit_config"}}}},
            {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "calibrator_fit_rows_with_labels"}}}},
            {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "calibrator_summary"}}}},
            {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "calibrator_producer"}}}}
          ]
        }
      }
    },
