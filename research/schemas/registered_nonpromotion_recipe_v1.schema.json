    "ordinary_strategy_score",
    "question_family_source",
    "comparison",
    "recipe_contract",
    "catalog_requirements",
    "source_inventory",
    "cohort",
    "metric",
    "sensitivity",
    "bootstrap",
    "execution_contract",
    "phase_plan",
    "replica_topology",
    "output_contract",
    "result_contract",
    "safety"
