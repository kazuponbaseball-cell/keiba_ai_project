    "score_components": {
      "$ref": "#/$defs/score_components"
    },
    "eligibility_contract": {
      "$ref": "#/$defs/eligibility_contract"
    },
    "formal_buy": {
      "const": false
    },
    "send_order": {
      "const": false
    },
    "stake": {
      "type": "integer",
      "const": 0
