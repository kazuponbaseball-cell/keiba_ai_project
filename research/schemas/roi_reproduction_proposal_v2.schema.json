    },
    "secondary_metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_effect": {
      "$ref": "#/$defs/required_effect"
    },
    "rejection_gate": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compute_budget": {
      "$ref": "#/$defs/compute_budget"
    },
    "allowed_variant_count": {
      "type": "integer",
      "const": 1
    },
    "allowed_threshold_search_count": {
      "type": "integer",
      "const": 0
