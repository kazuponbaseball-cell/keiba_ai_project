{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keiba-ai.local/schemas/roi_reproduction_proposal_v2.schema.json",
  "title": "ROI reproduction proposal v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "gate_kind",
    "gate_contract_version",
    "execution_kind",
    "policy_ref",
    "schema_ref",
    "title",
    "hypothesis",
    "null_hypothesis",
    "racing_mechanism",
    "non_promotion_purpose",
    "brain_provenance",
    "repository_contract",
    "target_population",
    "in_scope",
    "out_of_scope",
    "expected_changed_paths",
    "raw_data_sources",
    "data_as_of",
    "allowed_columns",
    "forbidden_columns",
    "lineage_hash_requirements",
    "chronological_fold_design",
    "fold_manifest_ref",
    "purge_embargo",
    "reference_catalog_contract_refs",
    "reference_catalog_entry_ref",
    "model_identity_contract",
    "primary_metric",
    "secondary_metrics",
    "required_effect",
    "rejection_gate",
    "stop_conditions",
    "compute_budget",
    "allowed_variant_count",
    "allowed_threshold_search_count",
    "score_components",
    "eligibility_contract",
    "formal_buy",
    "send_order",
    "stake",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
    },
    "gate_kind": {
      "const": "roi_reproduction_audit_v2"
    },
    "gate_contract_version": {
      "type": "integer",
      "const": 2
    },
    "execution_kind": {
      "const": "historical_reproduction_v2"
    },
    "policy_ref": {
      "$ref": "#/$defs/reference"
    },
    "schema_ref": {
      "$ref": "#/$defs/reference"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "null_hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "racing_mechanism": {
      "type": "string",
      "minLength": 1
    },
    "non_promotion_purpose": {
      "type": "string",
      "minLength": 1
    },
    "brain_provenance": {
      "$ref": "#/$defs/brain_provenance"
    },
    "repository_contract": {
      "$ref": "#/$defs/repository_contract"
    },
    "target_population": {
      "type": "string",
      "minLength": 1
    },
    "in_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "out_of_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_changed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
      }
    },
    "raw_data_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data_as_of": {
      "type": "string",
      "minLength": 1
    },
    "allowed_columns": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "critical_missing_count",
          "min_primary_strength",
          "min_rank_strength",
          "sum_primary_strength",
          "sum_rank_strength"
        ]
      }
    },
    "forbidden_columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
