{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kazuponbaseball-cell.github.io/keiba_ai_project/research/schemas/ordinary_real_data_run_v3.schema.json",
  "title": "Versioned Ordinary Real-Data Run Contract v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_scope_schema_version",
    "proposal_scope",
    "proposal_scope_digest",
    "execution_kind",
    "capability_profile",
    "execution_commit_sha",
    "code_hashes",
    "config_hashes",
    "data_input_manifest_hashes",
    "input_catalog",
    "runner_universe_manifest_hash",
    "feature_input_release_hash",
    "training_source_manifest_hash",
    "target_source_manifest_hash",
    "feature_lineage_manifest_hash",
    "label_eligibility_contract_hash",
    "fold_manifest_hash",
    "dependency_environment_lock_hash",
    "environment",
    "random_seed",
    "repository_working_directory",
    "exact_commands",
    "network_policy",
    "read_allowlist",
    "write_allowlist",
    "output_root",
    "compute_budget",
    "source_cutoff",
    "as_of",
    "phase_plan",
    "output_sealing_contract",
    "formal_buy",
    "send_order",
    "stake"
  ],
  "properties": {
    "run_scope_schema_version": {"const": "ordinary_real_data_run_v3"},
    "proposal_scope": {"type": "object"},
    "proposal_scope_digest": {"$ref": "#/$defs/sha256"},
    "execution_kind": {"enum": ["synthetic", "real_data"]},
    "capability_profile": {"$ref": "#/$defs/capabilityProfile"},
    "execution_commit_sha": {"$ref": "#/$defs/gitSha"},
    "code_hashes": {"$ref": "#/$defs/nonemptyRefs"},
    "config_hashes": {"$ref": "#/$defs/nonemptyRefs"},
    "data_input_manifest_hashes": {"$ref": "#/$defs/nonemptyRefs"},
    "input_catalog": {"$ref": "#/$defs/inputCatalog"},
    "runner_universe_manifest_hash": {"$ref": "#/$defs/ref"},
    "feature_input_release_hash": {"$ref": "#/$defs/artifactBinding"},
    "training_source_manifest_hash": {"$ref": "#/$defs/ref"},
    "target_source_manifest_hash": {"$ref": "#/$defs/ref"},
    "feature_lineage_manifest_hash": {"$ref": "#/$defs/artifactBinding"},
    "label_eligibility_contract_hash": {"$ref": "#/$defs/ref"},
    "fold_manifest_hash": {"$ref": "#/$defs/ref"},
    "dependency_environment_lock_hash": {"$ref": "#/$defs/ref"},
    "environment": {"$ref": "#/$defs/environment"},
    "random_seed": {"type": "integer", "minimum": 0},
    "repository_working_directory": {"type": "string", "minLength": 1},
    "exact_commands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/command"}
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowed_hosts"],
      "properties": {
        "mode": {"const": "disabled"},
        "allowed_hosts": {"const": []}
      }
    },
    "read_allowlist": {
      "type": "array",
      "items": {"$ref": "#/$defs/readAllow"}
    },
    "write_allowlist": {
      "type": "array",
      "items": {"$ref": "#/$defs/writeAllow"}
    },
    "output_root": {"$ref": "#/$defs/repositoryPath"},
    "compute_budget": {"$ref": "#/$defs/computeBudget"},
    "source_cutoff": {"$ref": "#/$defs/utcTimestamp"},
    "as_of": {"$ref": "#/$defs/utcTimestamp"},
    "phase_plan": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/phase"}
    },
    "output_sealing_contract": {"$ref": "#/$defs/outputContract"},
    "formal_buy": {"const": false},
    "send_order": {"const": false},
    "stake": {"const": 0}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nonemptyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref"}
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_real_input_manifests",
        "read_real_runner_rows",
        "canonicalize_input_release",
        "read_historical_training_rows",
        "read_sealed_canonical_input_release",
        "train_research_model",
        "validate_research_model",
        "calibrate_research_model",
        "evaluate_outer_oos_once",
        "infer_target_runners",
        "write_research_outputs",
        "seal_research_outputs",
        "production_model_write",
        "champion_change",
        "candidate_policy_change",
        "value_policy_change",
        "formal_buy",
        "notification",
        "order",
        "nonzero_stake",
        "merge",
        "production_promotion"
      ],
      "properties": {
        "read_real_input_manifests": {"type": "boolean"},
        "read_real_runner_rows": {"type": "boolean"},
        "canonicalize_input_release": {"type": "boolean"},
        "read_historical_training_rows": {"type": "boolean"},
        "read_sealed_canonical_input_release": {"type": "boolean"},
        "train_research_model": {"type": "boolean"},
        "validate_research_model": {"type": "boolean"},
        "calibrate_research_model": {"type": "boolean"},
        "evaluate_outer_oos_once": {"type": "boolean"},
        "infer_target_runners": {"type": "boolean"},
        "write_research_outputs": {"type": "boolean"},
        "seal_research_outputs": {"type": "boolean"},
        "production_model_write": {"const": false},
        "champion_change": {"const": false},
        "candidate_policy_change": {"const": false},
        "value_policy_change": {"const": false},
        "formal_buy": {"const": false},
        "notification": {"const": false},
        "order": {"const": false},
        "nonzero_stake": {"const": false},
        "merge": {"const": false},
        "production_promotion": {"const": false}
      }
    },
    "capabilityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "capabilities"],
      "properties": {
        "profile_id": {
          "enum": [
            "synthetic_governance_v1",
            "exp034_input_canonicalization_v1",
            "exp033_leakfree_research_v1"
          ]
        },
        "capabilities": {"$ref": "#/$defs/capabilities"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered_count", "total_count"],
      "properties": {
        "covered_count": {"type": "integer", "minimum": 0},
        "total_count": {"type": "integer", "minimum": 0}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "content_sha256", "signature_sha256", "signer_identity"],
      "properties": {
        "kind": {"const": "sha256_bound"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "signature_sha256": {"const": null},
        "signer_identity": {"const": null}
      }
    },
    "inputCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_id",
        "source_release_id",
        "manifest",
        "attestation",
        "row_count",
        "race_count",
        "runner_count",
        "source_event_time_coverage",
        "received_at_coverage",
        "available_as_of_coverage",
        "max_source_event_time",
        "max_received_at",
        "max_available_as_of",
        "revoked",
        "revocation_status",
        "runner_universe_digest",
        "runner_identity_digest",
        "target_date",
        "race_ids",
        "phase_read_capabilities",
        "metadata_manifest_refs",
        "row_blob_refs"
      ],
      "properties": {
        "catalog_id": {"type": "string", "minLength": 3},
        "source_release_id": {"type": "string", "minLength": 3},
        "manifest": {"$ref": "#/$defs/ref"},
        "attestation": {"$ref": "#/$defs/attestation"},
        "row_count": {"type": "integer", "minimum": 0},
        "race_count": {"type": "integer", "minimum": 0},
        "runner_count": {"type": "integer", "minimum": 0},
        "source_event_time_coverage": {"$ref": "#/$defs/coverage"},
        "received_at_coverage": {"$ref": "#/$defs/coverage"},
        "available_as_of_coverage": {"$ref": "#/$defs/coverage"},
        "max_source_event_time": {"$ref": "#/$defs/utcTimestamp"},
        "max_received_at": {"$ref": "#/$defs/utcTimestamp"},
        "max_available_as_of": {"$ref": "#/$defs/utcTimestamp"},
        "revoked": {"const": false},
        "revocation_status": {"const": "active"},
        "runner_universe_digest": {"$ref": "#/$defs/sha256"},
        "runner_identity_digest": {"$ref": "#/$defs/sha256"},
        "target_date": {"type": "string", "format": "date"},
        "race_ids": {"type": "array", "items": {"type": "string"}},
        "phase_read_capabilities": {"type": "array", "items": {"type": "string"}},
        "metadata_manifest_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/readAllow"}
        },
        "row_blob_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/readAllow"}
        }
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_role", "artifact_role", "contract", "producer_run_scope", "producer_execution_receipt", "producer_output_attestation", "artifact_manifest", "artifact_sha256"],
      "properties": {
        "binding_role": {"enum": ["planned_output_contract", "sealed_input_artifact"]},
        "artifact_role": {"type": "string", "minLength": 3},
        "contract": {"$ref": "#/$defs/ref"},
        "producer_run_scope": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
        "producer_execution_receipt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
        "producer_output_attestation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
        "artifact_manifest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
        "artifact_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpreter_path", "interpreter_version", "dependency_versions", "locale", "timezone"],
      "properties": {
        "interpreter_path": {"type": "string", "minLength": 1},
        "interpreter_version": {"type": "string", "pattern": "^3\\.(11|12)\\.[0-9]+$"},
        "dependency_versions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dependency"}},
        "locale": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "phase_id", "executable", "argv", "working_directory", "timeout_seconds"],
      "properties": {
        "command_id": {"type": "string", "minLength": 3},
        "phase_id": {"type": "string", "minLength": 3},
        "executable": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "working_directory": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "readAllow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "access_class", "required_capability", "phases"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "access_class": {"enum": ["metadata_manifest", "runner_row_blob", "canonicalization_source_row_blob", "historical_training_row_blob", "sealed_input_row_blob"]},
        "required_capability": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "phases": {"type": "array", "items": {"type": "string"}}
      }
    },
    "writeAllow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "required_capability", "phases"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "required_capability": {"const": "write_research_outputs"},
        "phases": {"type": "array", "items": {"type": "string"}}
      }
    },
    "computeBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "cpu_cores", "memory_mib", "disk_mib", "max_model_fits", "max_outer_oos_evaluations", "max_target_inference_calls"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "cpu_cores": {"type": "integer", "minimum": 1},
        "memory_mib": {"type": "integer", "minimum": 1},
        "disk_mib": {"type": "integer", "minimum": 1},
        "max_model_fits": {"type": "integer", "minimum": 0},
        "max_outer_oos_evaluations": {"type": "integer", "minimum": 0},
        "max_target_inference_calls": {"type": "integer", "minimum": 0}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_id", "required_capabilities", "command_id", "read_paths", "write_paths"],
      "properties": {
        "phase_id": {"type": "string", "minLength": 3},
        "required_capabilities": {"type": "array", "items": {"type": "string"}},
        "command_id": {"type": "string", "minLength": 3},
        "read_paths": {"type": "array", "items": {"$ref": "#/$defs/repositoryPath"}},
        "write_paths": {"type": "array", "items": {"$ref": "#/$defs/repositoryPath"}}
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mode", "execution_receipt_path", "result_manifest_path", "failure_manifest_path", "overwrite_allowed", "partial_output_consumer_eligible", "failure_manifest_required", "artifact_roles", "artifact_paths", "required_result_fields"],
      "properties": {
        "schema_version": {"const": "ordinary_real_data_result_v1"},
        "mode": {"const": "append_only_immutable"},
        "execution_receipt_path": {"$ref": "#/$defs/repositoryPath"},
        "result_manifest_path": {"$ref": "#/$defs/repositoryPath"},
        "failure_manifest_path": {"$ref": "#/$defs/repositoryPath"},
        "overwrite_allowed": {"const": false},
        "partial_output_consumer_eligible": {"const": false},
        "failure_manifest_required": {"const": true},
        "artifact_roles": {"type": "array", "items": {"type": "string"}},
        "artifact_paths": {"type": "array", "items": {"$ref": "#/$defs/artifactPath"}},
        "required_result_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "artifactPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path"],
      "properties": {
        "role": {"type": "string", "minLength": 3},
        "path": {"$ref": "#/$defs/repositoryPath"}
      }
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
