    "question_family_digest",
    "eligibility_ast_digest",
    "tier",
    "ordinary_strategy_score",
    "resolved_contracts",
    "runtime_bindings",
    "semantic_subject",
    "semantic_subject_digest",
    "exact_subject",
    "exact_subject_digest",
