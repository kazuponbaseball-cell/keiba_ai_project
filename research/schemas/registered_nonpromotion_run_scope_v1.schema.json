      "properties": {
        "comparison_id": {"const": "D1_REMOVE_RAW_GATES_MINUS_D0_REFERENCE"},
        "arm_ids": {"const": ["D0_REFERENCE", "D1_REMOVE_RAW_GATES"]},
        "registered_transform_id": {"const": "REMOVE_RAW_P_GATE_FAMILY"},
        "counterfactual_eligibility_mask_change": {"const": true},
        "candidate_identity_change": {"const": false},
        "candidate_rank_or_tier_change": {"const": false},
        "live_policy_or_config_mutation": {"const": false},
