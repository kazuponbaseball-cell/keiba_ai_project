        "refit_count": {"type": "integer", "const": 0},
        "recalibration_count": {"type": "integer", "const": 0}
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_id",
        "fold_values",
        "fold_counts",
        "race_count",
        "date_min",
        "date_max",
        "row_key",
        "race_id_format",
        "one_row_per_race",
        "reused_development_oos",
        "confirmatory_outer_oos",
        "strict_t3_rows",
        "settlement_basis"
      ],
      "properties": {
        "cohort_id": {"const": "CITED_FOLDS_2_TO_4"},
        "fold_values": {"const": ["fold2", "fold3", "fold4"]},
        "fold_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fold2", "fold3", "fold4"],
          "properties": {
            "fold2": {"type": "integer", "const": 1661},
            "fold3": {"type": "integer", "const": 1653},
            "fold4": {"type": "integer", "const": 432}
          }
        },
        "race_count": {"type": "integer", "const": 3746},
        "date_min": {"const": "2025-01-05"},
        "date_max": {"const": "2026-02-15"},
        "row_key": {"const": "race_id"},
        "race_id_format": {"const": "16_DIGIT_STRING"},
        "one_row_per_race": {"const": true},
        "reused_development_oos": {"const": true},
        "confirmatory_outer_oos": {"const": false},
        "strict_t3_rows": {"type": "integer", "const": 0},
        "settlement_basis": {"const": "FINAL_OFFICIAL_PAYOFF_ONLY"}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline_evaluation_notional_yen",
        "offline_evaluation_notional_is_stake",
        "artifact_stake",
        "evaluation_stake_formula",
        "evaluation_return_formula",
        "evaluation_profit_formula",
        "paired_delta_formula",
        "primary_metric",
        "secondary_metrics"
      ],
      "properties": {
        "offline_evaluation_notional_yen": {"type": "integer", "const": 100},
        "offline_evaluation_notional_is_stake": {"const": false},
        "artifact_stake": {"type": "integer", "const": 0},
        "evaluation_stake_formula": {"const": "100_IF_ELIGIBLE_ELSE_ZERO"},
        "evaluation_return_formula": {"const": "OFFICIAL_WIDE_PAY_IF_ELIGIBLE_AND_HIT_ELSE_ZERO"},
        "evaluation_profit_formula": {"const": "EVALUATION_RETURN_MINUS_EVALUATION_STAKE"},
        "paired_delta_formula": {"const": "PROFIT_D1_MINUS_PROFIT_D0"},
        "primary_metric": {"const": "SUM_DELTA_PROFIT_DIVIDED_BY_3746_ENROLLED_RACES"},
        "secondary_metrics": {
          "const": [
            "arm_bet_count",
            "arm_hit_count",
            "arm_profit_yen",
            "arm_return_yen",
            "arm_roi_percent",
            "arm_stake_denominator_yen",
            "decision_disagreement_count"
          ]
        }
      }
    },
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "common_high_payout_sets",
        "high_payout_set_is_arm_independent",
        "high_payout_rows_retained_and_return_zeroed",
        "winsor_cap_yen",
        "winsor_applied_before_arm_eligibility"
      ],
      "properties": {
        "common_high_payout_sets": {"const": ["TOP1_SETTLED_CANDIDATE_RETURN", "TOP3_SETTLED_CANDIDATE_RETURN"]},
        "high_payout_set_is_arm_independent": {"const": true},
        "high_payout_rows_retained_and_return_zeroed": {"const": true},
        "winsor_cap_yen": {"type": "integer", "const": 2000},
        "winsor_applied_before_arm_eligibility": {"const": true}
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_key",
        "cluster_ordering",
        "within_cluster_ordering",
        "replicates",
        "seed",
        "rng",
        "draw_call_per_replicate",
        "statistic",
        "one_sided_95_lower_bound"
      ],
      "properties": {
        "cluster_key": {"const": ["race_date", "venue_code"]},
        "cluster_ordering": {"const": "UNIQUE_TUPLES_LEXICOGRAPHIC_ASCENDING"},
        "within_cluster_ordering": {"const": "RACE_ID_ASCENDING"},
        "replicates": {"type": "integer", "const": 100000},
        "seed": {"type": "integer", "const": 20260814},
        "rng": {"const": "numpy.random.Generator(PCG64)"},
        "draw_call_per_replicate": {"const": "rng.integers(0,n_clusters,size=n_clusters,dtype=np.int64,endpoint=False)_EXACTLY_ONCE"},
        "statistic": {"const": "SUM_DELTA_PROFIT_DIVIDED_BY_RESAMPLED_RACE_ROW_COUNT_INCLUDING_MULTIPLICITY"},
        "one_sided_95_lower_bound": {"const": "numpy.quantile(statistics,0.05,method=linear)"}
      }
    },
