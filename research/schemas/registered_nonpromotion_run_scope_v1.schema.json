    "recipe_id": {"const": "historical_ai_duplicate_gate_impact_v1"},
    "recipe_version": {"type": "integer", "const": 1},
    "recipe_digest": {"$ref": "#/definitions/sha256"},
    "question_family_digest": {"$ref": "#/definitions/sha256"},
    "eligibility_ast_digest": {"$ref": "#/definitions/sha256"},
    "tier": {"const": "B_REGISTERED_HISTORICAL_IMPACT"},
    "ordinary_strategy_score": {"$ref": "#/definitions/ordinary_strategy_score"},
    "resolved_contracts": {"$ref": "#/definitions/resolved_contracts"},
    "runtime_bindings": {"$ref": "#/definitions/runtime_bindings"},
    "semantic_subject": {"$ref": "#/definitions/semantic_subject"},
    "semantic_subject_digest": {"$ref": "#/definitions/sha256"},
    "exact_subject": {"$ref": "#/definitions/exact_subject"},
    "exact_subject_digest": {"$ref": "#/definitions/sha256"},
    "approval_keyword": {"const": "APPROVED_NONPROMOTION_DIAGNOSTIC_RUN"},
    "sealed_at": {"$ref": "#/definitions/utc_timestamp"},
    "output_root": {"$ref": "#/definitions/output_root"},
    "formal_buy": {"const": false},
    "send_order": {"const": false},
    "stake": {"type": "integer", "const": 0},
    "run_scope_digest": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safe_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "output_root": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.\u002f-]+$"
    },
    "ordinary_strategy_score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_total",
        "threshold",
        "threshold_met",
        "status",
        "score_credit",
        "threshold_override_allowed"
      ],
      "properties": {
        "recorded_total": {"type": "integer", "const": 46},
        "threshold": {"type": "integer", "const": 75},
        "threshold_met": {"const": false},
        "status": {"const": "BLOCKED_SCORE"},
        "score_credit": {"type": "integer", "const": 0},
        "threshold_override_allowed": {"const": false}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
