{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kazuponbaseball-cell.github.io/keiba_ai_project/research/schemas/ordinary_real_data_environment_lock_v1.schema.json",
  "title": "Ordinary Real-Data Environment Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment"],
  "properties": {
    "schema_version": {"const": "ordinary_real_data_environment_lock_v1"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpreter_path", "interpreter_version", "dependency_versions", "locale", "timezone"],
      "properties": {
        "interpreter_path": {"type": "string", "minLength": 1},
        "interpreter_version": {"type": "string", "pattern": "^3\\.(11|12)\\.[0-9]+$"},
        "dependency_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        },
        "locale": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1}
      }
    }
  }
}
