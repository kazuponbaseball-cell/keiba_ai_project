{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kazuponbaseball-cell.github.io/keiba_ai_project/research/schemas/ordinary_real_data_output_attestation_v1.schema.json",
  "title": "Ordinary Real-Data Output Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_schema_version",
    "producer_experiment_id",
    "producer_run_scope_path",
    "producer_run_scope_digest",
    "running_event_id",
    "execution_receipt_path",
    "execution_receipt_sha256",
    "execution_receipt_digest",
    "result_manifest_path",
    "result_manifest_sha256",
    "result_manifest_digest",
    "artifacts_digest",
    "output_root",
    "status",
    "consumer_eligible",
    "attested_at",
    "formal_buy",
    "send_order",
    "stake"
  ],
  "properties": {
    "attestation_schema_version": {"const": "ordinary_real_data_output_attestation_v1"},
    "producer_experiment_id": {"const": "EXP-20260821-034"},
    "producer_run_scope_path": {"$ref": "ordinary_real_data_run_v3.schema.json#/$defs/repositoryPath"},
    "producer_run_scope_digest": {"$ref": "ordinary_real_data_run_v3.schema.json#/$defs/sha256"},
    "running_event_id": {"type": "string", "minLength": 3},
    "execution_receipt_path": {"$ref": "ordinary_real_data_run_v3.schema.json#/$defs/repositoryPath"},
    "execution_receipt_sha256": {"$ref": "ordinary_real_data_run_v3.schema.json#/$defs/sha256"},
    "execution_receipt_digest": {"$ref": "ordinary_real_data_run_v3.schema.json#/$defs/sha256"},
    "result_manifest_path": {"$ref": "ordinary_real_data_run_v3.schema.json#/$defs/repositoryPath"},
    "result_manifest_sha256": {"$ref": "ordinary_real_data_run_v3.schema.json#/$defs/sha256"},
    "result_manifest_digest": {"$ref": "ordinary_real_data_run_v3.schema.json#/$defs/sha256"},
    "artifacts_digest": {"$ref": "ordinary_real_data_run_v3.schema.json#/$defs/sha256"},
    "output_root": {"$ref": "ordinary_real_data_run_v3.schema.json#/$defs/repositoryPath"},
    "status": {"const": "success"},
    "consumer_eligible": {"const": true},
    "attested_at": {"$ref": "ordinary_real_data_run_v3.schema.json#/$defs/utcTimestamp"},
    "formal_buy": {"const": false},
    "send_order": {"const": false},
    "stake": {"const": 0}
  }
}
