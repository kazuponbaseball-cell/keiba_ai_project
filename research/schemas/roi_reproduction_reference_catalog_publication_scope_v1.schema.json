{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keiba-ai.local/schemas/roi_reproduction_reference_catalog_publication_scope_v1.schema.json",
  "title": "ROI reproduction catalog publication scope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_kind",
    "catalog_contract_version",
    "scope_id",
    "gate_kind",
    "gate_contract_version",
    "policy_ref",
    "schema_ref",
    "repository_contract",
    "provider_contract",
    "source_requests",
    "expected_metadata_schema",
    "resource_budget",
    "capabilities",
    "formal_buy",
    "send_order",
    "stake"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "catalog_kind": {
      "const": "roi_reproduction_reference_catalog_v1"
    },
    "catalog_contract_version": {
      "type": "integer",
      "const": 1
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
    },
    "gate_kind": {
      "const": "roi_reproduction_audit_v2"
    },
    "gate_contract_version": {
      "type": "integer",
      "const": 2
    },
    "policy_ref": {
      "$ref": "#/$defs/reference"
    },
    "schema_ref": {
      "$ref": "#/$defs/reference"
    },
    "repository_contract": {
      "$ref": "#/$defs/repository_contract"
    },
    "provider_contract": {
      "$ref": "#/$defs/provider_contract"
    },
    "source_requests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source_request"
      }
    },
    "expected_metadata_schema": {
      "$ref": "#/$defs/metadata_schema"
    },
    "resource_budget": {
      "$ref": "#/$defs/resource_budget"
    },
    "capabilities": {
      "$ref": "#/$defs/catalog_capabilities"
    },
    "formal_buy": {
      "const": false
    },
    "send_order": {
      "const": false
    },
    "stake": {
      "type": "integer",
      "const": 0
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "repository_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base_branch",
        "base_commit"
      ],
      "properties": {
        "repository": {
          "const": "kazuponbaseball-cell/keiba_ai_project"
        },
        "base_branch": {
          "const": "main"
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "provider_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_kind",
        "provider_version",
        "execution_commit",
        "code_sha256",
        "environment_sha256",
        "command_template_id",
        "network_required",
        "raw_rows_returned"
      ],
      "properties": {
        "provider_kind": {
          "type": "string",
          "minLength": 1
        },
        "provider_version": {
          "type": "string",
          "minLength": 1
        },
        "execution_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "code_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "command_template_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
        },
        "network_required": {
          "const": false
        },
        "raw_rows_returned": {
          "const": false
        }
      }
    },
    "source_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_source_id",
        "role"
      ],
      "properties": {
        "logical_source_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metadata_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_fields",
        "raw_values_allowed",
        "absolute_paths_allowed",
        "secrets_allowed"
      ],
      "properties": {
        "allowed_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "raw_values_allowed": {
          "const": false
        },
        "absolute_paths_allowed": {
          "const": false
        },
        "secrets_allowed": {
          "const": false
        }
      }
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_bytes",
        "maximum_runtime_seconds",
        "network_calls",
        "retry_budget"
      ],
      "properties": {
        "maximum_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_runtime_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "network_calls": {
          "type": "integer",
          "const": 0
        },
        "retry_budget": {
          "type": "integer",
          "const": 0
        }
      }
    },
    "catalog_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_codex_dispatch",
        "automatic_execution",
        "automatic_github_approval",
        "synthetic_fixture_tests",
        "real_data_execution",
        "supervised_manifest_hash_read",
        "raw_row_output",
        "model_real_data_access",
        "historical_result_label_access",
        "historical_training",
        "historical_replay",
        "prospective_outer_oos",
        "backtest_interpretation",
        "price_access",
        "payoff_access",
        "roi_calculation",
        "offline_unit_notional_evaluation",
        "research_candidate_policy_change",
        "production_candidate_policy_change",
        "workload_network_access",
        "workload_external_api_calls",
        "credential_access",
        "purchase_path_access",
        "production_change",
        "shadow_approval",
        "merge",
        "notification_side_effects",
        "order_side_effects",
        "formal_buy",
        "send_order",
        "stake"
      ],
      "properties": {
        "actual_codex_dispatch": {
          "const": false
        },
        "automatic_execution": {
          "const": false
        },
        "automatic_github_approval": {
          "const": false
        },
        "synthetic_fixture_tests": {
          "const": false
        },
        "real_data_execution": {
          "const": true
        },
        "supervised_manifest_hash_read": {
          "const": true
        },
        "raw_row_output": {
          "const": false
        },
        "model_real_data_access": {
          "const": false
        },
        "historical_result_label_access": {
          "const": false
        },
        "historical_training": {
          "const": false
        },
        "historical_replay": {
          "const": false
        },
        "prospective_outer_oos": {
          "const": false
        },
        "backtest_interpretation": {
          "const": false
        },
        "price_access": {
          "const": false
        },
        "payoff_access": {
          "const": false
        },
        "roi_calculation": {
          "const": false
        },
        "offline_unit_notional_evaluation": {
          "const": false
        },
        "research_candidate_policy_change": {
          "const": false
        },
        "production_candidate_policy_change": {
          "const": false
        },
        "workload_network_access": {
          "const": false
        },
        "workload_external_api_calls": {
          "const": false
        },
        "credential_access": {
          "const": false
        },
        "purchase_path_access": {
          "const": false
        },
        "production_change": {
          "const": false
        },
        "shadow_approval": {
          "const": false
        },
        "merge": {
          "const": false
        },
        "notification_side_effects": {
          "const": false
        },
        "order_side_effects": {
          "const": false
        },
        "formal_buy": {
          "const": false
        },
        "send_order": {
          "const": false
        },
        "stake": {
          "type": "integer",
          "const": 0
        }
      }
    }
  }
}
