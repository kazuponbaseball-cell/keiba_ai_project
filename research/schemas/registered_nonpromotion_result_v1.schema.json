{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://keiba-ai.local/schemas/registered_nonpromotion_result_v1.schema.json",
  "title": "Registered non-promotion diagnostic sealed result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_kind",
    "gate_kind",
    "run_scope_digest",
    "recipe_id",
    "recipe_version",
    "recipe_digest",
    "question_family_digest",
    "semantic_subject_digest",
    "exact_subject_digest",
    "comparison_projection_digest",
    "policy_schema_verifier_digest",
    "scientific_projection_digest",
    "computed_outcome",
    "evidence_purpose_class",
    "source_authority_class",
    "confirmatory",
    "reused_development_oos",
    "strict_t3_rows",
    "promotion_eligible",
    "score_credit",
    "shadow_transition_supported",
    "production_transition_supported",
    "formal_buy",
    "send_order",
    "stake",
    "result_projection_digest",
    "comparison_phase_output_seal_receipt_digest",
    "result_phase_output_seal_receipt_digest",
    "result_digest"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "projection_kind": {"const": "REGISTERED_NONPROMOTION_RESULT_PROJECTION_V1"},
    "gate_kind": {"const": "registered_nonpromotion_diagnostic_v1"},
    "run_scope_digest": {"$ref": "#/definitions/sha256"},
    "recipe_id": {"const": "historical_ai_duplicate_gate_impact_v1"},
    "recipe_version": {"type": "integer", "const": 1},
    "recipe_digest": {"$ref": "#/definitions/sha256"},
    "question_family_digest": {"$ref": "#/definitions/sha256"},
    "semantic_subject_digest": {"$ref": "#/definitions/sha256"},
    "exact_subject_digest": {"$ref": "#/definitions/sha256"},
    "comparison_projection_digest": {"$ref": "#/definitions/sha256"},
    "policy_schema_verifier_digest": {"$ref": "#/definitions/sha256"},
    "scientific_projection_digest": {"$ref": "#/definitions/sha256"},
    "computed_outcome": {"enum": ["NO_DECISION_EFFECT", "DIRECTIONAL_EFFECT", "INVALID"]},
    "evidence_purpose_class": {"const": "DIAGNOSTIC_NONPROMOTION"},
    "source_authority_class": {"const": "B_LOCAL_HASHED"},
    "confirmatory": {"const": false},
    "reused_development_oos": {"const": true},
    "strict_t3_rows": {"type": "integer", "const": 0},
    "promotion_eligible": {"const": false},
    "score_credit": {"type": "integer", "const": 0},
    "shadow_transition_supported": {"const": false},
    "production_transition_supported": {"const": false},
    "formal_buy": {"const": false},
    "send_order": {"const": false},
    "stake": {"type": "integer", "const": 0},
    "result_projection_digest": {"$ref": "#/definitions/sha256"},
    "comparison_phase_output_seal_receipt_digest": {"$ref": "#/definitions/sha256"},
    "result_phase_output_seal_receipt_digest": {"$ref": "#/definitions/sha256"},
    "result_digest": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
