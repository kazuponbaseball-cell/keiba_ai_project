  "m0_identity_blockers": [
    "legacy_run_mode_core_or_full",
    "canonical_probability_stage_M0_raw_or_M0_temperature_scaled",
    "exact_canonical_model_name",
    "exact_command_and_comparison_artifact_ids",
    "legacy_B0_B1_B2_M0_ablation_parity_scope_or_explicit_exclusion",
    "canonical_full_per_set_reference_digest",
    "state_metric_unit_and_provenance_mapping",
    "state_nll_fold_mean_or_race_weighted_mapping",
    "upstream_ai_score_and_ai_rank_oof_as_of_price_blind_lineage",
    "legacy_input_environment_and_runner_universe_authority"
  ],
  "m0_seed_static_recipe_observations_non_authoritative": {
    "model": "linear_race_group_softmax",
    "target": "unordered_triple_exactly_equals_set_of_runners_with_finish_num_le_3",
    "ordered_features": [
      "sum_primary_strength",
      "min_primary_strength",
      "sum_rank_strength",
      "min_rank_strength",
      "critical_missing_count"
    ],
    "intercept": false,
    "initialization": "zero",
    "learning_rate": 0.18,
    "candidate_epochs": 100,
    "candidate_preprocessing_population": "train_only",
    "l2_grid": [0.0, 0.005, 0.02, 0.08],
    "l2_selection_partition": "validation",
    "l2_tie_break": "first_grid_value",
    "refit_epochs": 140,
    "refit_population": "train_plus_validation",
    "refit_preprocessing_population": "train_plus_validation",
    "standard_deviation_ddof": 0,
    "zero_standard_deviation_replacement": 1.0,
    "temperature_selection_partition": "calibration",
    "temperature_grid_candidate_count": 37,
    "temperature_grid_min": 0.2,
    "temperature_grid_max": 3.0,
    "temperature_tie_break": "first_grid_value",
    "softmax_utility_difference_clip": [-50.0, 50.0],
    "authority": false,
    "must_be_attested_and_resolved_before_run_scope": true,
    "proposal_may_bind_only_the_finite_identity_domain": true
