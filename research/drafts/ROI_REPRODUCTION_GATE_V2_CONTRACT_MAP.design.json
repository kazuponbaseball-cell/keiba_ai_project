      "horse_id_2",
      "horse_id_3",
      "runner_count",
      "top3_probability"
    ],
    "all_unordered_C_n_3_exactly_once": true,
    "top3_set_mass": 1.0,
    "derived_wide_mass": 3.0,
    "absolute_tolerance": 1e-10,
    "finite_range_duplicate_and_runner_count_checks": true,
    "label_and_abnormal_result_validator_separate": true,
    "price_payoff_and_roi_access": false
  },
  "decision_rules": {
    "REPRODUCED": "two clean replicas are bitwise canonical-equal and match a trusted canonical legacy reference under the preregistered exact identity contract",
    "RECONSTRUCTED_NOT_REPRODUCED": "two clean replicas are bitwise canonical-equal and pass preregistered numeric tolerances but no trusted canonical legacy reference identity exists",
    "REPRODUCTION_FAILED": "safety and structural contracts pass but determinism or preregistered numeric equivalence does not pass",
    "REJECTED": "human review declines to accept the evidence without upgrading any computed outcome",
    "INVALID": "approval scope lineage probability capability or safety contract violation",
    "automatic_reproduced_classification": false,
    "success_grants_strategy_score_or_shadow_or_buy": false,
